{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisFailedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "AnalysisFailed"
    },
    "eventVersion": {
      "type": "integer",
      "const": 3
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisId",
        "attemptId",
        "modelName",
        "modelVersion",
        "errorMessage"
      ],
      "properties": {
        "analysisId": {
          "type": "string",
          "format": "uuid"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "modelName": {
          "type": "string"
        },
        "modelVersion": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        }
      }
    }
  }
}
