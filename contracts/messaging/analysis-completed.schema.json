{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisCompletedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "AnalysisCompleted"
    },
    "eventVersion": {
      "type": "integer",
      "const": 2
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisId",
        "modelName",
        "modelVersion",
        "resultObjectKey",
        "detections"
      ],
      "properties": {
        "analysisId": {
          "type": "string",
          "format": "uuid"
        },
        "modelName": {
          "type": "string"
        },
        "modelVersion": {
          "type": "string"
        },
        "resultObjectKey": {
          "type": "string"
        },
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "confidence", "x", "y", "width", "height"],
            "properties": {
              "label": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
